{
  "name": "CareConnect",
  "short_name": "CareConnect",
  "description": "A compassionate daily companion that helps caregivers stay connected, organised, and calm while looking after someone who needs a little help remembering.",
  "id": "./",
  "start_url": "./app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["health", "lifestyle", "medical"],
  "theme_color": "#146488",
  "background_color": "#f7f8fa",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "See today's care plan at a glance",
      "url": "./app"
    },
    {
      "name": "Medications",
      "short_name": "Medications",
      "description": "Review and manage medications",
      "url": "./app/manage-medications"
    }
  ]
}
