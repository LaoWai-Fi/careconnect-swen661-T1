# Standard React Native / Expo .gitignore (matches `npx create-expo-app`)

node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env.local

# typescript
*.tsbuildinfo

# Testing
coverage/

# Xcode / Android build output (bare workflow)
ios/build/
ios/Pods/
android/app/build/
android/build/
android/.gradle/
